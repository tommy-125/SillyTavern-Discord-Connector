# Stable SillyTavern image version used by deploy/sillytavern/Dockerfile.
SILLYTAVERN_VERSION=1.18.0

# SillyTavern is published on host loopback only. Use an SSH tunnel or a
# protected reverse proxy if you need remote access.
SILLYTAVERN_PORT=8000

# OpenRouter model ID in provider/model form. This is required by the browser
# worker. Examples can be copied directly from an OpenRouter model page.
OPENROUTER_MODEL=

# Disable hidden chain-of-thought for low-latency roleplay. Set auto/min/low/
# medium/high/max only when a task genuinely benefits from model reasoning.
OPENROUTER_REASONING_EFFORT=none

# OpenRouter API key. This is injected into browser-worker and memory-service
# as an environment variable. Keep .env private and never commit or share it.
OPENROUTER_API_KEY=

# Character card copied into SillyTavern on the first deployment. The default
# matches this workspace's sibling kuro-character repository.
ST_CHARACTER_CARD_PATH=../../kuro/kuro-character/Kuro-character-card-gpt-5.6-sol/Kuro_chara_card.discord.dedup.png
ST_CHARACTER_FILE_NAME=Kuro.png
ST_DEFAULT_CHARACTER=Kuro
ST_DEFAULT_PERSONA=User
ST_UI_LANGUAGE=en

# Optional HTTP Basic Auth for the SillyTavern web page. These values configure
# both SillyTavern and the headless browser through Compose.
ST_BASIC_AUTH_ENABLED=false
ST_BASIC_AUTH_USERNAME=
ST_BASIC_AUTH_PASSWORD=

# Browser worker tuning (milliseconds).
CONNECTOR_UI_TIMEOUT_MS=120000
CONNECTOR_WATCH_INTERVAL_MS=15000

# Event-oriented long-term memory. Discord IDs identify event participants,
# channel memories stay local, and only important decisions/summaries may be global.
# Recall is fail-open.
MEMORY_ENABLED=true
MEMORY_RECALL_TIMEOUT_MS=500
MEMORY_CHARACTER_ID=Kuro
MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MEMORY_EXTRACTION_MODEL=deepseek/deepseek-v4-flash
MEMORY_MAINTENANCE_INTERVAL_SECONDS=21600
MEMORY_TRASH_RETENTION_DAYS=30

# Authenticated connection from the Go kurohelper bot. Use the same value as
# KURO_RUNTIME_SECRET in kurohelper/.env. The port is bound to host loopback.
KUROHELPER_BRIDGE_SECRET=replace-with-a-long-random-value
KUROHELPER_RUNTIME_PORT=2334
